{
  "name": "@clientdesk/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./auth": "./src/auth/password.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "generate": "bun --env-file=../../.env x drizzle-kit generate",
    "migrate": "bun --env-file=../../.env src/migrate.ts",
    "studio": "drizzle-kit studio",
    "admin:create": "bun --env-file=../../.env src/cli/create-admin.ts",
    "seed:demo": "bun --env-file=../../.env src/cli/seed-demo.ts",
    "seed:load": "bun --env-file=../../.env src/cli/seed-load.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
