# Vorlage für infra/.env.production auf dem Server. Die echte Datei liegt nur
# dort, gehört root und ist nur für root lesbar (chmod 600). infra/deploy.sh
# erzeugt sie beim ersten Lauf selbst, mit Werten aus openssl rand; von Hand
# braucht es sie nur für einen Aufbau ohne das Skript, etwa lokal.
# Hier stehen ausschliesslich Platzhalter.

# --- Adresse -----------------------------------------------------------------
SITE_ADDRESS=tallyroom.adambaranyi.xyz
APP_ORIGIN=https://tallyroom.adambaranyi.xyz

# --- Geheimnisse, je einmal erzeugen -----------------------------------------
# openssl rand -base64 48
SESSION_SECRET=bitte-ersetzen-mindestens-32-zeichen-lang
# openssl rand -hex 24
POSTGRES_PASSWORD=bitte-ersetzen
# openssl rand -hex 32
GARAGE_RPC_SECRET=bitte-ersetzen
# echo "GK$(openssl rand -hex 12)"
S3_ACCESS_KEY_ID=bitte-ersetzen
# openssl rand -hex 32
S3_SECRET_ACCESS_KEY=bitte-ersetzen

# --- Impressum ---------------------------------------------------------------
# Nicht geheim, aber bewusst nicht im öffentlichen Repository. deploy.sh
# übernimmt sie einmal aus der Umgebung, siehe Kommentar dort.
OPERATOR_STREET="Strasse und Nummer"
OPERATOR_CITY="PLZ Ort"
OPERATOR_EMAIL="adresse@example.invalid"
# Freiwillig. Leer lassen, wenn keine Nummer im Impressum stehen soll.
OPERATOR_PHONE=""

# --- Funktionen --------------------------------------------------------------
DEMO_ENABLED=true

# --- Version der Images --------------------------------------------------------
# Setzt infra/deploy.sh aus dem Commit. Nur ohne Skript von Hand nötig.
TALLYROOM_VERSION=local
