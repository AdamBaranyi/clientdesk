{
  "name": "clientdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --filter '@clientdesk/api' --filter '@clientdesk/web' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-length": "bun scripts/check-file-length.mjs",
    "verify": "bun run format:check && bun run check:file-length && bun run lint && bun run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "bun run --filter '@clientdesk/db' generate",
    "db:migrate": "bun run --filter '@clientdesk/db' migrate",
    "admin:create": "bun run --filter '@clientdesk/db' admin:create",
    "seed:demo": "bun run --filter '@clientdesk/db' seed:demo",
    "seed:load": "bun run --filter '@clientdesk/db' seed:load",
    "measure": "bun --env-file=.env scripts/measure-performance.ts"
  },
  "devDependencies": {
    "@clientdesk/contracts": "workspace:*",
    "@clientdesk/db": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "drizzle-orm": "0.45.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
