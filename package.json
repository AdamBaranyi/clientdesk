{
  "name": "tallyroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --filter '@tallyroom/api' --filter '@tallyroom/web' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-length": "bun scripts/check-file-length.mjs",
    "verify": "bun run format:check && bun run check:file-length && bun run lint && bun run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "bun run --filter '@tallyroom/db' generate",
    "db:migrate": "bun run --filter '@tallyroom/db' migrate",
    "admin:create": "bun run --filter '@tallyroom/db' admin:create",
    "admin:reset-password": "bun run --filter '@tallyroom/db' admin:reset-password",
    "seed:demo": "bun run --filter '@tallyroom/db' seed:demo",
    "seed:load": "bun run --filter '@tallyroom/db' seed:load",
    "measure": "bun --env-file=.env scripts/measure-performance.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:browsers": "playwright test -c playwright.browsers.config.ts",
    "check:bundle-size": "bun run --filter '@tallyroom/web' build && bun scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@tallyroom/contracts": "workspace:*",
    "@tallyroom/db": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.57.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "drizzle-orm": "0.45.2",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "playwright": "1.57.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
