# Kopiere diese Datei nach .env und trage lokale Werte ein.
# Hier stehen ausschliesslich Platzhalter, niemals echte Geheimnisse.

# --- Datenbank -------------------------------------------------------------
DATABASE_URL=postgresql://tallyroom:tallyroom_local@localhost:5440/tallyroom
TEST_DATABASE_URL=postgresql://tallyroom:tallyroom_local@localhost:5441/tallyroom_test

# --- API -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=bitte-ersetzen-mindestens-32-zeichen-lang
# Origin der Weboberfläche. Wird für CORS und CSRF-Origin-Prüfung verwendet.
APP_ORIGIN=http://localhost:5173
# Anzahl vertrauenswürdiger Proxy-Hops. Lokal 0, hinter Caddy 1.
TRUST_PROXY_HOPS=0

# --- Funktionen ------------------------------------------------------------
DEMO_ENABLED=true
# Wie viele Demos je IP und Viertelstunde gestartet werden dürfen.
DEMO_RATE_LIMIT_MAX=5

# --- Objektspeicher --------------------------------------------------------
# Lokal MinIO aus infra/docker-compose.yml. Der Bucket ist privat.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=tallyroom-documents
S3_ACCESS_KEY_ID=tallyroom
S3_SECRET_ACCESS_KEY=tallyroom_local_secret
