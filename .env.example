# Kopiere diese Datei nach .env und trage lokale Werte ein.
# Hier stehen ausschliesslich Platzhalter, niemals echte Geheimnisse.

# --- Datenbank -------------------------------------------------------------
DATABASE_URL=postgresql://clientdesk:clientdesk_local@localhost:5440/clientdesk
TEST_DATABASE_URL=postgresql://clientdesk:clientdesk_local@localhost:5441/clientdesk_test

# --- API -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=bitte-ersetzen-mindestens-32-zeichen-lang
# Origin der Weboberfläche. Wird für CORS und CSRF-Origin-Prüfung verwendet.
APP_ORIGIN=http://localhost:5173
# Anzahl vertrauenswürdiger Proxy-Hops. Lokal 0, hinter Caddy 1.
TRUST_PROXY_HOPS=0

# --- Funktionen ------------------------------------------------------------
DEMO_ENABLED=true

# --- Objektspeicher --------------------------------------------------------
# Lokal MinIO aus infra/docker-compose.yml. Der Bucket ist privat.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=clientdesk-documents
S3_ACCESS_KEY_ID=clientdesk
S3_SECRET_ACCESS_KEY=clientdesk_local_secret
